# Copy to .env and fill in. Every service is configured via env only (12-factor).

# --- Core infrastructure ---
# `pnpm db:migrate` doesn't load .env automatically — run it as:
#   pnpm --filter @mainline/db exec tsx --env-file=/absolute/path/to/.env src/migrate.ts
DATABASE_URL=postgres://mainline:mainline@localhost:5432/mainline
REDIS_URL=redis://localhost:6379
MOTIS_URL=http://localhost:8080
# Optional: run Drizzle migrations before the production web server starts.
# Prefer running migrations manually/on a one-off Coolify command for deploys
# where a failed migration would restart-loop the web container.
RUN_DB_MIGRATIONS=

# --- Live map (/map) vector tiles ---
# Browser-facing base URL of the self-hosted OpenRailwayMap-vector proxy (see
# the orm-db/orm-import/orm-martin/orm-proxy services in docker-compose.yml).
# Requires a one-time GB OSM import — see the orm-db service comment there.
# This is a Next public env var, so it is baked into the web image at build
# time. In Coolify, set it before building/deploying the web container and
# rebuild the image after changing it.
NEXT_PUBLIC_TILES_URL=http://localhost:8081
# Must match NEXT_PUBLIC_TILES_URL's host:port (no protocol) — martin rewrites
# tile URLs inside tilejson responses to this value, so a mismatch silently
# breaks tile loading even though /style/standard.json itself looks fine.
ORM_PUBLIC_HOST=localhost:8081

# --- RDG Rail Data Marketplace: Darwin real-time (Kafka over SSL) ---
# From your RDM subscription page. Topic/bootstrap values: verify on first integration.
RDM_KAFKA_BOOTSTRAP_SERVERS=
RDM_KAFKA_TOPIC=
# Optional — defaults to a generated group id if unset.
RDM_KAFKA_GROUP_ID=
RDM_CONSUMER_KEY=
RDM_CONSUMER_SECRET=

# --- RailData: Network Rail Train Describer TD (Kafka over SSL) ---
# Separate subscription credentials from Darwin. When these are set, nr-ingest
# consumes TD_ALL_SIG_AREA from RailData Kafka while keeping TRUST movements on
# the existing Network Rail feed.
NR_TD_KAFKA_BOOTSTRAP_SERVERS=pkc-z3p1v0.europe-west2.gcp.confluent.cloud:9092
NR_TD_KAFKA_TOPIC=TD_ALL_SIG_AREA
NR_TD_KAFKA_GROUP_ID=mainline-nr-td-ingest
NR_TD_KAFKA_USERNAME=
NR_TD_KAFKA_PASSWORD=

# --- RDG static feeds (DTD downloads: timetable RJTTF, fares RJFAF) ---
# Either RDM file-feed URLs or NRDP opendata.nationalrail.co.uk credentials.
NRDP_USERNAME=
NRDP_PASSWORD=

# --- DTD SFTP delivery (alternative to the NRDP HTTPS download above) ---
# Separate RDG account from NRDP_USERNAME/PASSWORD — issued when you register
# for SFTP push/pull delivery instead of (or alongside) the staticfeed API.
# If DTD_SFTP_HOST is set, the ETL pulls the newest .zip from these dirs via
# SFTP instead of calling the NRDP HTTPS endpoint. The etl-cron service (see
# docker-compose.yml) uses this nightly at 2am.
DTD_SFTP_HOST=
DTD_SFTP_PORT=22
DTD_SFTP_USERNAME=
DTD_SFTP_PASSWORD=
DTD_SFTP_TIMETABLE_DIR=/
DTD_SFTP_FARES_DIR=/

# --- Network Rail reference/Track Model SFTP drops ---
# Uses DTD_SFTP_* credentials when these are blank. Set these if RDG supplied a
# separate SFTP account or folders for SMARTExtract.*, TPS_Data.tar.gz and
# NWR_TrackModel*.
NR_SFTP_HOST=
NR_SFTP_PORT=22
NR_SFTP_USERNAME=
NR_SFTP_PASSWORD=
NR_SFTP_REFERENCE_DIR=/
NR_SFTP_TRACK_MODEL_DIR=/
# Default is to delete remote files after successful processing. Set false for
# a dry-run/first integration.
NR_SFTP_DELETE_PROCESSED=true
NR_TPS_DIR=/data/tps
NR_REFERENCE_SYNC_INTERVAL_SECONDS=21600

# --- LDBWS Live Arrival and Departure Boards (RDM REST API) — primary board source ---
# Consumer key goes in the x-apikey header.
# Subscribe to the RDM Live Arrival and Departure Boards product. This base URL
# is separate from the departure-only board product.
LDBWS_API_KEY=
LDBWS_BASE_URL=https://api1.raildata.org.uk/1010-live-arrival-and-departure-boards-arr-and-dep1_1/LDBWS/api/20220120
LDBWS_BOARD_OPERATION=GetArrDepBoardWithDetails

# Service Details (per-train calling pattern) — separate RDM product/key.
LDBWS_SERVICE_API_KEY=
LDBWS_SERVICE_BASE_URL=https://api1.raildata.org.uk/1010-service-details1_2/LDBWS/api/20220120

# --- National Rail Disruptions API (RDM REST) ---
DISRUPTIONS_API_KEY=
DISRUPTIONS_BASE_URL=https://api1.raildata.org.uk/1010-disruptions-experience-api-11_1

# --- TfL Unified API (tube/bus/DLR/Overground/Elizabeth line/tram) ---
# Free app_key from api-portal.tfl.gov.uk; sent as an app_key query param.
TFL_APP_KEY=
TFL_BASE_URL=https://api.tfl.gov.uk

# --- Network Rail Open Data (STOMP) — positioning feeds ---
# NO API key: use your datafeeds.networkrail.co.uk account email + password.
# Subscribe to TRAIN_MVT_ALL_TOC and TD_ALL_SIG_AREA on the "My Feeds" page first.
NETWORKRAIL_USERNAME=
NETWORKRAIL_PASSWORD=
# Optional overrides (defaults are correct):
# NR_STOMP_HOST=publicdatafeeds.networkrail.co.uk
# NR_STOMP_PORT=61618
# Trajectory-based rid disambiguation for headcodes shared by 2+ candidate
# services on the same day (e.g. two different TOCs reusing the same 4-char
# headcode) — compares actual reported stops against each candidate's
# schedule. Off by default; set to "1" once you've reviewed
# "[nr][trajectory-shadow]" log lines and are happy with its picks.
NR_TRAJECTORY_MATCH=

# --- Knowledgebase / disruptions ---
KB_FEED_URL=

# --- ETL scratch database (MariaDB sidecar for dtd2mysql, compose profile "etl") ---
ETL_MYSQL_URL=mysql://root:etl@localhost:3306/dtd

# --- Sign-in (Better Auth: passkey + magic link, no passwords) ---
# Generate once with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where this app is reachable — http://localhost:3000 for local dev.
BETTER_AUTH_URL=http://localhost:3000
# From resend.com — used to send magic-link sign-in emails.
RESEND_API_KEY=

# --- Timetable bundle upload (/settings/timetable) ---
# Required for /api/etl/upload, /api/etl/upload-raw and /api/etl/sftp-sync —
# a request needs either an admin's session cookie (the settings page, once
# you're signed in and promoted to role "admin" — see packages/db/src/schema.ts)
# or this API key, sent as the x-api-key header. That covers etl-cron's
# unattended nightly run, which has no one logged in.
#
# Generate one after your first sign-up + admin promotion by running:
#   pnpm --filter web exec tsx scripts/create-etl-api-key.ts <your-admin-user-id>
# (see that script for how to find your user id). Paste the printed key here —
# it's shown once and can't be recovered afterwards.
ETL_API_KEY=
# Must match the actual motis container name on the deploy host — verify with
# `docker compose ps motis` if the restart-after-apply step fails. On Coolify,
# project/service names are prefixed/suffixed differently — check the actual
# name in the Coolify UI (or `docker ps`) rather than assuming this default.
MOTIS_CONTAINER_NAME=mainline-motis-1
# Same caveat as MOTIS_CONTAINER_NAME — used by /api/etl/sftp-sync to trigger
# an on-demand SFTP pull inside the etl-cron container. Verify with
# `docker compose ps etl-cron`.
ETL_CRON_CONTAINER_NAME=mainline-etl-cron-1
# Same caveat again — used by the all-SFTP sync button and by etl-cron's 2am
# sweep to run SMART/TPS reference processing inside the nr-reference-sync
# container.
NR_REFERENCE_SYNC_CONTAINER_NAME=mainline-nr-reference-sync-1

# --- Web Push for commute disruption alerts (darwin-ingest sends, web registers) ---
# Generate a keypair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@mainline.local
