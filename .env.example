# Copy to .env and fill in. Every service is configured via env only (12-factor).

# --- Core infrastructure ---
DATABASE_URL=postgres://mainline:mainline@localhost:5432/mainline
REDIS_URL=redis://localhost:6379
MOTIS_URL=http://localhost:8080

# --- RDG Rail Data Marketplace: Darwin real-time (Kafka over SSL) ---
# From your RDM subscription page. Topic/bootstrap values: verify on first integration.
RDM_KAFKA_BOOTSTRAP_SERVERS=
RDM_KAFKA_TOPIC=
RDM_CONSUMER_KEY=
RDM_CONSUMER_SECRET=

# --- RDG static feeds (DTD downloads: timetable RJTTF, fares RJFAF) ---
# Either RDM file-feed URLs or NRDP opendata.nationalrail.co.uk credentials.
NRDP_USERNAME=
NRDP_PASSWORD=

# --- DTD SFTP delivery (alternative to the NRDP HTTPS download above) ---
# Separate RDG account from NRDP_USERNAME/PASSWORD — issued when you register
# for SFTP push/pull delivery instead of (or alongside) the staticfeed API.
# If DTD_SFTP_HOST is set, the ETL pulls the newest .zip from these dirs via
# SFTP instead of calling the NRDP HTTPS endpoint. The etl-cron service (see
# docker-compose.yml) uses this nightly at 2am.
DTD_SFTP_HOST=
DTD_SFTP_PORT=22
DTD_SFTP_USERNAME=
DTD_SFTP_PASSWORD=
DTD_SFTP_TIMETABLE_DIR=/timetable
DTD_SFTP_FARES_DIR=/fares

# --- LDBWS Live Departure Board (RDM REST API) — primary board source ---
# Consumer key goes in the x-apikey header.
LDBWS_API_KEY=
LDBWS_BASE_URL=https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120

# Service Details (per-train calling pattern) — separate RDM product/key.
LDBWS_SERVICE_API_KEY=
LDBWS_SERVICE_BASE_URL=https://api1.raildata.org.uk/1010-service-details1_2/LDBWS/api/20220120

# --- National Rail Disruptions API (RDM REST) ---
DISRUPTIONS_API_KEY=
DISRUPTIONS_BASE_URL=https://api1.raildata.org.uk/1010-disruptions-experience-api-11_1

# --- Network Rail Open Data (STOMP) — positioning feeds ---
# NO API key: use your datafeeds.networkrail.co.uk account email + password.
# Subscribe to TRAIN_MVT_ALL_TOC and TD_ALL_SIG_AREA on the "My Feeds" page first.
NETWORKRAIL_USERNAME=
NETWORKRAIL_PASSWORD=
# Optional overrides (defaults are correct):
# NR_STOMP_HOST=publicdatafeeds.networkrail.co.uk
# NR_STOMP_PORT=61618

# --- Knowledgebase / disruptions ---
KB_FEED_URL=

# --- ETL scratch database (MariaDB sidecar for dtd2mysql, compose profile "etl") ---
ETL_MYSQL_URL=mysql://root:etl@localhost:3306/dtd

# --- Web Push for commute disruption alerts (darwin-ingest sends, web registers) ---
# Generate a keypair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@mainline.local
