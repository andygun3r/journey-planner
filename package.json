{
  "name": "mainline",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "docker:up": "docker compose up -d --build",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @mainline/db generate",
    "db:migrate": "pnpm --filter @mainline/db migrate",
    "etl:timetable": "pnpm --filter @mainline/etl timetable",
    "timetable:update": "docker compose --profile etl build etl && docker compose --profile etl run --rm etl timetable && docker compose --profile routing run --rm motis /motis import -d /data/data -c /data/config.yml && docker compose --profile routing restart motis"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
